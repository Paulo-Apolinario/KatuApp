generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String        @id @default(cuid())
  email                  String        @unique
  passwordHash           String
  displayName            String
  role                   UserRole
  accountStatus          AccountStatus @default(ACTIVE)
  isActive               Boolean       @default(true)
  phone                  String?
  rememberMe             Boolean       @default(false)
  resetPasswordToken     String?
  resetPasswordExpiresAt DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  collector          Collector?
  cooperative        Cooperative?
  driver             Driver?
  generator          Generator?
  personProfile      PersonProfile?
  feedbacks          Feedback[]
  requestedSchedules Schedule[]     @relation("UserRequestedSchedules")

  @@index([role])
}

model Cooperative {
  id                 String  @id @default(cuid())
  name               String
  registrationNumber String? @unique
  email              String? @unique
  phone              String?

  // Endereço estruturado
  zipCode      String?
  street       String?
  number       String?
  neighborhood String?
  city         String?
  state        String?
  address      String?

  // Coordenadas para mapa
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collections        Collection[]
  collectors         Collector[]
  collectorDocuments CollectorDocument[]
  drivers            Driver[]
  generators         Generator[]
  routes             Route[]
  schedules          Schedule[]
  vehicles           Vehicle[]
  feedbacks          Feedback[]
  wasteStockItems    WasteStockItem[]
  wasteStockLots     WasteStockLot[]
  bins               Bin[]
  vehicleDocuments   VehicleDocument[]
  maintenanceLogs    MaintenanceLog[]

  @@index([name])
  @@index([city])
  @@index([state])
}

model DriverReport {
  id           String           @id @default(cuid())
  driverId     String
  type         DriverReportType
  description  String
  routeId      String?
  vehicleId    String?
  collectionId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  driver     Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  route      Route?      @relation(fields: [routeId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([driverId])
  @@index([type])
  @@index([routeId])
  @@index([vehicleId])
  @@index([collectionId])
  @@index([createdAt])
}

model PersonProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  cpf         String   @unique
  address     String?
  totalKg     Float    @default(0)
  greenStreak Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Generator {
  id            String        @id @default(cuid())
  cooperativeId String
  userId        String?       @unique
  type          GeneratorType
  name          String
  companyName   String?
  email         String        @unique
  phone         String?

  // Endereço estruturado
  zipCode      String?
  street       String?
  number       String?
  neighborhood String?
  city         String?
  state        String?
  address      String?

  // Coordenadas para mapa
  latitude  Float?
  longitude Float?

  status         String?
  accessReleased Boolean               @default(false)
  accessStatus   GeneratorAccessStatus @default(PENDING_ACTIVATION)
  totalKg        Float                 @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  activatedAt    DateTime?

  collections Collection[]
  cooperative Cooperative  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])
  schedules   Schedule[]

  @@index([cooperativeId])
  @@index([type])
  @@index([accessStatus])
  @@index([name])
  @@index([city])
  @@index([state])
}

model Schedule {
  id                String         @id @default(uuid())
  cooperativeId     String
  generatorId       String?
  requestedByUserId String
  preferredDate     DateTime?
  scheduledDate     DateTime?
  status            ScheduleStatus @default(REQUESTED)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  generator   Generator?  @relation(fields: [generatorId], references: [id], onDelete: SetNull)
  requestedBy User        @relation("UserRequestedSchedules", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  collections Collection[]
  feedbacks   Feedback[]

  @@index([cooperativeId])
  @@index([generatorId])
  @@index([requestedByUserId])
  @@index([status])
}

model Collector {
  id            String  @id @default(cuid())
  cooperativeId String?
  userId        String? @unique

  name       String
  socialName String?
  email      String           @unique
  phone      String?
  cpf        String?
  rg         String?
  birthDate  String?
  sex        CollectorSex?
  gender     CollectorGender?
  address    String?

  associationDate DateTime?
  isAutonomous    Boolean   @default(false)

  incomeRange          String?
  socialBenefits       String?
  occupationalDiseases String?
  socioeconomicNotes   String?

  status           CollectorStatus @default(AVAILABLE)
  kgMonth          Float           @default(0)
  collectionsToday Int             @default(0)
  totalKg          Float           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections Collection[]
  documents   CollectorDocument[]

  cooperative Cooperative? @relation(fields: [cooperativeId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@index([cooperativeId])
  @@index([status])
  @@index([name])
  @@index([cpf])
  @@index([sex])
  @@index([gender])
  @@index([associationDate])
}

model CollectorDocument {
  id            String  @id @default(cuid())
  collectorId   String
  cooperativeId String?

  documentType String?
  documentName String?
  fileUrl      String
  fileMimeType String?
  fileSize     Int?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collector   Collector    @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  cooperative Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: SetNull)

  @@index([collectorId])
  @@index([cooperativeId])
  @@index([documentType])
}

model Collection {
  id            String  @id @default(cuid())
  cooperativeId String
  generatorId   String?
  collectorId   String?
  scheduleId    String? @unique

  driverId  String?
  vehicleId String?
  routeId   String?

  collectedAt   DateTime?
  totalWeightKg Float            @default(0)
  materials     Json?
  notes         String?
  status        CollectionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  collector   Collector?  @relation(fields: [collectorId], references: [id])
  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  generator   Generator?  @relation(fields: [generatorId], references: [id], onDelete: SetNull)
  schedule    Schedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  driver  Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  route   Route?         @relation(fields: [routeId], references: [id], onDelete: SetNull)
  reports DriverReport[]

  @@index([cooperativeId])
  @@index([generatorId])
  @@index([collectorId])
  @@index([scheduleId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([routeId])
  @@index([status])
}

model Driver {
  id            String       @id @default(cuid())
  cooperativeId String
  userId        String?      @unique
  name          String
  email         String       @unique
  phone         String?
  cpf           String?
  cnh           String?
  cnhCategory   String?
  notes         String?
  status        DriverStatus @default(AVAILABLE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  cooperative Cooperative    @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id])
  routes      Route[]
  vehicles    Vehicle[]
  collections Collection[]
  reports     DriverReport[]

  @@index([cooperativeId])
  @@index([status])
  @@index([name])
  @@index([cpf])
}

model Vehicle {
  id            String        @id @default(cuid())
  cooperativeId String
  driverId      String?
  plate         String        @unique
  model         String
  brand         String?
  year          Int?
  capacityKg    Float         @default(0)
  status        VehicleStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  routes          Route[]
  collections     Collection[]
  reports         DriverReport[]
  documents       VehicleDocument[]
  maintenanceLogs MaintenanceLog[]
  bins            Bin[]

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  driver      Driver?     @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([cooperativeId])
  @@index([driverId])
  @@index([status])
  @@index([plate])
}

model Route {
  id            String      @id @default(cuid())
  cooperativeId String
  driverId      String?
  vehicleId     String?
  name          String
  description   String?
  scheduledDate DateTime?
  stops         String[]
  status        RouteStatus @default(SCHEDULED)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  cooperative Cooperative    @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  driver      Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle     Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  collections Collection[]
  reports     DriverReport[]

  @@index([cooperativeId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
}

model Feedback {
  id            String             @id @default(cuid())
  userId        String
  cooperativeId String
  scheduleId    String?
  npsScore      Int
  categories    FeedbackCategory[]
  reason        String?
  improvement   String?
  likes         String?
  continuity    String?
  emailSent     Boolean            @default(false)
  emailedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  schedule    Schedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([cooperativeId])
  @@index([scheduleId])
  @@index([createdAt])
}

/**
 * Catálogo de resíduos da cooperativa.
 * Cada cooperativa/OSC administra os próprios tipos de resíduos.
 * Exemplos:
 * - Papelão
 * - Óleo de cozinha usado
 * - Poda de árvore
 * - Pneus
 * - Colchões
 * - Eletrônicos
 */
model WasteStockItem {
  id            String @id @default(cuid())
  cooperativeId String

  name        String
  category    String
  subcategory String?

  /**
   * Unidade padrão usada pelo material.
   * Exemplos:
   * Papelão -> KG
   * Óleo de cozinha -> LITER
   * Pneus -> UNIT
   * Poda -> CUBIC_METER
   */
  unit WasteUnit @default(KG)

  ncm          String?
  internalCode String?
  wasteClass   WasteClass       @default(NOT_INFORMED)
  description  String?
  status       WasteStockStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cooperative Cooperative     @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  lots        WasteStockLot[]

  @@index([cooperativeId])
  @@index([name])
  @@index([category])
  @@index([subcategory])
  @@index([unit])
  @@index([ncm])
  @@index([internalCode])
  @@index([wasteClass])
  @@index([status])
}

/**
 * Lotes físicos vinculados aos tipos de resíduos.
 * quantity:
 * Campo oficial para novas operações, respeitando a unidade do material.
 * quantityKg:
 * Campo legado mantido temporariamente para compatibilidade com os dados e
 * códigos anteriores. Ele será sincronizado durante a transição quando a
 * unidade do material for KG.
 */
model WasteStockLot {
  id            String @id @default(cuid())
  cooperativeId String
  stockItemId   String

  lotCode String

  quantity Float?

  /**
   * Campo legado.
   * Não remover antes da migração completa das telas, serviços e relatórios.
   */
  quantityKg Float @default(0)

  /**
   * A unidade do lote é gravada para preservar o histórico, mesmo que a
   * unidade padrão do tipo de resíduo seja alterada posteriormente.
   */
  unit WasteUnit @default(KG)

  storageLocation String?
  processingStage WasteProcessingStage @default(TRIADO)
  origin          String?
  notes           String?
  status          WasteLotStatus       @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cooperative Cooperative    @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  stockItem   WasteStockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([cooperativeId])
  @@index([stockItemId])
  @@index([lotCode])
  @@index([unit])
  @@index([status])
  @@index([processingStage])
}

model Bin {
  id                 String    @id @default(cuid())
  cooperativeId      String
  vehicleId          String?
  binId              String
  binType            String?
  location           String?
  capacityKg         Float?
  notes              String?
  photoUrl           String?
  lastCollectionDate DateTime?
  status             BinStatus @default(ACTIVE)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([cooperativeId, binId])
  @@index([cooperativeId])
  @@index([vehicleId])
  @@index([status])
  @@index([binType])
}

model VehicleDocument {
  id             String    @id @default(cuid())
  cooperativeId  String
  vehicleId      String?
  documentType   String
  documentNumber String
  issueDate      DateTime?
  expiryDate     DateTime?
  fileUrl        String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([cooperativeId])
  @@index([vehicleId])
  @@index([documentType])
  @@index([expiryDate])
}

model MaintenanceLog {
  id                  String            @id @default(cuid())
  cooperativeId       String
  vehicleId           String
  maintenanceType     String
  maintenanceDate     DateTime
  location            String?
  cost                Float?
  performedBy         String?
  nextMaintenanceDate DateTime?
  notes               String?
  fileUrl             String?
  status              MaintenanceStatus @default(COMPLETED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([cooperativeId])
  @@index([vehicleId])
  @@index([status])
  @@index([maintenanceDate])
  @@index([nextMaintenanceDate])
}

enum UserRole {
  PF
  GENERATOR_SMALL
  GENERATOR_LARGE
  COOPERATIVE
  COLLECTOR
  DRIVER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum GeneratorType {
  SMALL
  LARGE
}

enum GeneratorAccessStatus {
  PENDING_ACTIVATION
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CollectorStatus {
  AVAILABLE
  ON_ROUTE
  INACTIVE
}

enum CollectorSex {
  FEMALE
  MALE
  INTERSEX
  NOT_INFORMED
}

enum CollectorGender {
  CIS_WOMAN
  CIS_MAN
  TRANS_WOMAN
  TRANS_MAN
  NON_BINARY
  OTHER
  NOT_INFORMED
}

enum ScheduleStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CollectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DriverStatus {
  AVAILABLE
  ON_ROUTE
  INACTIVE
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum DriverReportType {
  DELAY
  MECHANICAL_ISSUE
  COLLECTION_NOT_COMPLETED
  GENERAL_NOTE
}

enum RouteStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FeedbackCategory {
  ATENDIMENTO
  PONTUALIDADE
  COLETA
  APLICATIVO
  COMUNICACAO
}

enum WasteStockStatus {
  ACTIVE
  INACTIVE
}

enum WasteLotStatus {
  AVAILABLE
  RESERVED
  SOLD
  DISCARDED
}

enum WasteProcessingStage {
  TRIADO
  TRITURADO
  PRENSADO
  ENFARDADO
  ARMAZENADO
  DESTINADO
}

/**
 * Unidade utilizada para pesagem, medição e estoque.
 */
enum WasteUnit {
  KG
  TON
  LITER
  UNIT
  CUBIC_METER
}

/**
 * Classificação operacional do resíduo.
 * CLASS_I:
 * Resíduos perigosos.
 * CLASS_II_A:
 * Resíduos não inertes.
 * CLASS_II_B:
 * Resíduos inertes.
 */
enum WasteClass {
  CLASS_I
  CLASS_II_A
  CLASS_II_B
  NOT_INFORMED
}

enum BinStatus {
  ACTIVE
  INACTIVE
  FULL
  MAINTENANCE
}

enum MaintenanceStatus {
  COMPLETED
  PENDING
  SCHEDULED
  OVERDUE
}
