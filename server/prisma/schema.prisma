generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String        @id @default(cuid())
  email                  String        @unique
  passwordHash           String
  displayName            String
  role                   UserRole
  accountStatus          AccountStatus @default(ACTIVE)
  isActive               Boolean       @default(true)
  phone                  String?
  rememberMe             Boolean       @default(false)
  resetPasswordToken     String?
  resetPasswordExpiresAt DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  collector          Collector?
  cooperative        Cooperative?
  driver             Driver?
  generator          Generator?
  personProfile      PersonProfile?
  feedbacks          Feedback[]
  requestedSchedules Schedule[]     @relation("UserRequestedSchedules")

  createdCollectionWasteEntries CollectionWasteEntry[]       @relation("CollectionWasteEntryCreatedBy")
  createdWasteDestinations      CollectionWasteDestination[] @relation("CollectionWasteDestinationCreatedBy")
  cancelledWasteDestinations    CollectionWasteDestination[] @relation("CollectionWasteDestinationCancelledBy")
  createdWasteStockLots         WasteStockLot[]              @relation("WasteStockLotCreatedBy")

  @@index([role])
}

model Cooperative {
  id                 String  @id @default(cuid())
  name               String
  registrationNumber String? @unique
  email              String? @unique
  phone              String?

  zipCode      String?
  street       String?
  number       String?
  neighborhood String?
  city         String?
  state        String?
  address      String?

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique

  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  collections                 Collection[]
  collectors                  Collector[]
  collectorDocuments          CollectorDocument[]
  drivers                     Driver[]
  generators                  Generator[]
  routes                      Route[]
  schedules                   Schedule[]
  vehicles                    Vehicle[]
  feedbacks                   Feedback[]
  wasteStockItems             WasteStockItem[]
  wasteStockLots              WasteStockLot[]
  bins                        Bin[]
  vehicleDocuments            VehicleDocument[]
  maintenanceLogs             MaintenanceLog[]
  collectionWasteEntries      CollectionWasteEntry[]
  collectionWasteDestinations CollectionWasteDestination[]

  @@index([name])
  @@index([city])
  @@index([state])
}

model DriverReport {
  id           String           @id @default(cuid())
  driverId     String
  type         DriverReportType
  description  String
  routeId      String?
  vehicleId    String?
  collectionId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  driver     Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  route      Route?      @relation(fields: [routeId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([driverId])
  @@index([type])
  @@index([routeId])
  @@index([vehicleId])
  @@index([collectionId])
  @@index([createdAt])
}

model PersonProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  cpf         String   @unique
  address     String?
  totalKg     Float    @default(0)
  greenStreak Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Generator {
  id            String        @id @default(cuid())
  cooperativeId String
  userId        String?       @unique
  type          GeneratorType
  name          String
  companyName   String?
  email         String        @unique
  phone         String?

  zipCode      String?
  street       String?
  number       String?
  neighborhood String?
  city         String?
  state        String?
  address      String?

  latitude  Float?
  longitude Float?

  status         String?
  accessReleased Boolean               @default(false)
  accessStatus   GeneratorAccessStatus @default(PENDING_ACTIVATION)
  totalKg        Float                 @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  activatedAt    DateTime?

  collections            Collection[]
  cooperative            Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  user                   User?                  @relation(fields: [userId], references: [id])
  schedules              Schedule[]
  collectionWasteEntries CollectionWasteEntry[]

  @@index([cooperativeId])
  @@index([type])
  @@index([accessStatus])
  @@index([name])
  @@index([city])
  @@index([state])
}

model Schedule {
  id                String         @id @default(uuid())
  cooperativeId     String
  generatorId       String?
  requestedByUserId String
  preferredDate     DateTime?
  scheduledDate     DateTime?
  status            ScheduleStatus @default(REQUESTED)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  generator   Generator?  @relation(fields: [generatorId], references: [id], onDelete: SetNull)
  requestedBy User        @relation("UserRequestedSchedules", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  collections Collection[]
  feedbacks   Feedback[]

  @@index([cooperativeId])
  @@index([generatorId])
  @@index([requestedByUserId])
  @@index([status])
}

model Collector {
  id            String  @id @default(cuid())
  cooperativeId String?
  userId        String? @unique

  name       String
  socialName String?
  email      String           @unique
  phone      String?
  cpf        String?
  rg         String?
  birthDate  String?
  sex        CollectorSex?
  gender     CollectorGender?
  address    String?

  associationDate DateTime?
  isAutonomous    Boolean   @default(false)

  incomeRange          String?
  socialBenefits       String?
  occupationalDiseases String?
  socioeconomicNotes   String?

  status           CollectorStatus @default(AVAILABLE)
  kgMonth          Float           @default(0)
  collectionsToday Int             @default(0)
  totalKg          Float           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections            Collection[]
  documents              CollectorDocument[]
  cooperative            Cooperative?           @relation(fields: [cooperativeId], references: [id])
  user                   User?                  @relation(fields: [userId], references: [id])
  collectionWasteEntries CollectionWasteEntry[]

  @@index([cooperativeId])
  @@index([status])
  @@index([name])
  @@index([cpf])
  @@index([sex])
  @@index([gender])
  @@index([associationDate])
}

model CollectorDocument {
  id            String  @id @default(cuid())
  collectorId   String
  cooperativeId String?

  documentType String?
  documentName String?
  fileUrl      String
  fileMimeType String?
  fileSize     Int?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collector   Collector    @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  cooperative Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: SetNull)

  @@index([collectorId])
  @@index([cooperativeId])
  @@index([documentType])
}

model Collection {
  id            String  @id @default(cuid())
  cooperativeId String
  generatorId   String?
  collectorId   String?
  scheduleId    String? @unique

  driverId  String?
  vehicleId String?
  routeId   String?

  collectedAt   DateTime?
  totalWeightKg Float            @default(0)
  materials     Json?
  notes         String?
  status        CollectionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  collector               Collector?             @relation(fields: [collectorId], references: [id], onDelete: SetNull)
  cooperative             Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  generator               Generator?             @relation(fields: [generatorId], references: [id], onDelete: SetNull)
  schedule                Schedule?              @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  driver                  Driver?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle                 Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  route                   Route?                 @relation(fields: [routeId], references: [id], onDelete: SetNull)
  reports                 DriverReport[]
  collectionMaterials     CollectionMaterial[]
  collectionWasteEntries  CollectionWasteEntry[]
  generatedWasteStockLots WasteStockLot[]        @relation("WasteStockLotOriginCollection")

  @@index([cooperativeId])
  @@index([generatorId])
  @@index([collectorId])
  @@index([scheduleId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([routeId])
  @@index([status])
  @@index([collectedAt])
}

model CollectionMaterial {
  id           String  @id @default(cuid())
  collectionId String
  wasteTypeId  String?

  nameSnapshot        String
  categorySnapshot    String?
  subcategorySnapshot String?
  unit                WasteUnit @default(KG)
  quantity            Decimal   @db.Decimal(18, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection              Collection            @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  wasteType               WasteStockItem?       @relation(fields: [wasteTypeId], references: [id], onDelete: SetNull)
  wasteEntry              CollectionWasteEntry?
  generatedWasteStockLots WasteStockLot[]       @relation("WasteStockLotOriginCollectionMaterial")

  @@index([collectionId])
  @@index([wasteTypeId])
  @@index([unit])
  @@index([nameSnapshot])
  @@index([createdAt])
}

model CollectionWasteEntry {
  id String @id @default(cuid())

  cooperativeId        String
  collectionId         String
  collectionMaterialId String  @unique
  wasteTypeId          String?

  generatorId String?
  routeId     String?
  vehicleId   String?
  driverId    String?
  collectorId String?

  materialNameSnapshot String
  categorySnapshot     String?
  subcategorySnapshot  String?
  unit                 WasteUnit @default(KG)

  collectedQuantity Decimal @db.Decimal(18, 3)
  destinedQuantity  Decimal @default(0) @db.Decimal(18, 3)
  remainingQuantity Decimal @db.Decimal(18, 3)

  status CollectionEntryStatus @default(PENDING_DESTINATION)

  origin      String?
  notes       String?
  collectedAt DateTime?

  createdByUserId       String?
  createdByNameSnapshot String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cooperative             Cooperative                  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  collection              Collection                   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionMaterial      CollectionMaterial           @relation(fields: [collectionMaterialId], references: [id], onDelete: Cascade)
  wasteType               WasteStockItem?              @relation(fields: [wasteTypeId], references: [id], onDelete: SetNull)
  generator               Generator?                   @relation(fields: [generatorId], references: [id], onDelete: SetNull)
  route                   Route?                       @relation(fields: [routeId], references: [id], onDelete: SetNull)
  vehicle                 Vehicle?                     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver                  Driver?                      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  collector               Collector?                   @relation(fields: [collectorId], references: [id], onDelete: SetNull)
  createdBy               User?                        @relation("CollectionWasteEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  destinations            CollectionWasteDestination[]
  generatedWasteStockLots WasteStockLot[]              @relation("WasteStockLotOriginCollectionWasteEntry")

  @@index([cooperativeId])
  @@index([collectionId])
  @@index([collectionMaterialId])
  @@index([wasteTypeId])
  @@index([generatorId])
  @@index([routeId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([collectorId])
  @@index([createdByUserId])
  @@index([status])
  @@index([unit])
  @@index([collectedAt])
  @@index([createdAt])
}

model CollectionWasteDestination {
  id String @id @default(cuid())

  cooperativeId          String
  collectionWasteEntryId String
  stockItemId            String?
  stockLotId             String? @unique

  type     WasteDestinationType
  quantity Decimal              @db.Decimal(18, 3)
  unit     WasteUnit

  destinationName       String?
  destinationDocument   String?
  destinationAddress    String?
  destinationContact    String?
  transportDocument     String?
  environmentalDocument String?
  notes                 String?
  metadata              Json?

  destinationDate DateTime               @default(now())
  status          WasteDestinationStatus @default(ACTIVE)

  createdByUserId   String?
  cancelledAt       DateTime?
  cancelledReason   String?
  cancelledByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cooperative          Cooperative          @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  collectionWasteEntry CollectionWasteEntry @relation(fields: [collectionWasteEntryId], references: [id], onDelete: Cascade)
  stockItem            WasteStockItem?      @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  stockLot             WasteStockLot?       @relation("WasteStockLotDestination", fields: [stockLotId], references: [id], onDelete: SetNull)
  createdBy            User?                @relation("CollectionWasteDestinationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledBy          User?                @relation("CollectionWasteDestinationCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  @@index([cooperativeId])
  @@index([collectionWasteEntryId])
  @@index([stockItemId])
  @@index([type])
  @@index([unit])
  @@index([status])
  @@index([createdByUserId])
  @@index([cancelledByUserId])
  @@index([destinationDate])
  @@index([createdAt])
}

model Driver {
  id            String       @id @default(cuid())
  cooperativeId String
  userId        String?      @unique
  name          String
  email         String       @unique
  phone         String?
  cpf           String?
  cnh           String?
  cnhCategory   String?
  notes         String?
  status        DriverStatus @default(AVAILABLE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  cooperative            Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  user                   User?                  @relation(fields: [userId], references: [id])
  routes                 Route[]
  vehicles               Vehicle[]
  collections            Collection[]
  reports                DriverReport[]
  collectionWasteEntries CollectionWasteEntry[]

  @@index([cooperativeId])
  @@index([status])
  @@index([name])
  @@index([cpf])
}

model Vehicle {
  id            String        @id @default(cuid())
  cooperativeId String
  driverId      String?
  plate         String        @unique
  model         String
  brand         String?
  year          Int?
  capacityKg    Float         @default(0)
  status        VehicleStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  routes                 Route[]
  collections            Collection[]
  reports                DriverReport[]
  documents              VehicleDocument[]
  maintenanceLogs        MaintenanceLog[]
  bins                   Bin[]
  cooperative            Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  driver                 Driver?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  collectionWasteEntries CollectionWasteEntry[]

  @@index([cooperativeId])
  @@index([driverId])
  @@index([status])
  @@index([plate])
}

model Route {
  id            String      @id @default(cuid())
  cooperativeId String
  driverId      String?
  vehicleId     String?
  name          String
  description   String?
  scheduledDate DateTime?
  stops         String[]
  status        RouteStatus @default(SCHEDULED)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  cooperative            Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  driver                 Driver?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle                Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  collections            Collection[]
  reports                DriverReport[]
  collectionWasteEntries CollectionWasteEntry[]

  @@index([cooperativeId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
}

model Feedback {
  id            String             @id @default(cuid())
  userId        String
  cooperativeId String
  scheduleId    String?
  npsScore      Int
  categories    FeedbackCategory[]
  reason        String?
  improvement   String?
  likes         String?
  continuity    String?
  emailSent     Boolean            @default(false)
  emailedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  schedule    Schedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([cooperativeId])
  @@index([scheduleId])
  @@index([createdAt])
}

model WasteStockItem {
  id            String @id @default(cuid())
  cooperativeId String

  name        String
  category    String
  subcategory String?

  defaultUnit WasteUnit @default(KG)
  isActive    Boolean   @default(true)

  unit         WasteUnit        @default(KG)
  ncm          String?
  internalCode String?
  wasteClass   WasteClass       @default(NOT_INFORMED)
  description  String?
  status       WasteStockStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cooperative            Cooperative                  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  lots                   WasteStockLot[]
  collectionMaterials    CollectionMaterial[]
  collectionWasteEntries CollectionWasteEntry[]
  wasteDestinations      CollectionWasteDestination[]

  @@unique([cooperativeId, internalCode])
  @@index([cooperativeId])
  @@index([name])
  @@index([category])
  @@index([subcategory])
  @@index([defaultUnit])
  @@index([unit])
  @@index([ncm])
  @@index([wasteClass])
  @@index([isActive])
  @@index([status])
}

model WasteStockLot {
  id            String @id @default(cuid())
  cooperativeId String
  stockItemId   String

  code    String?
  lotCode String?

  quantity          Decimal?  @default(0) @db.Decimal(18, 3)
  availableQuantity Decimal   @default(0) @db.Decimal(18, 3)
  quantityKg        Float     @default(0)
  unit              WasteUnit @default(KG)

  storageLocation String?
  processingStage WasteProcessingStage @default(TRIADO)
  origin          String?
  notes           String?
  status          WasteLotStatus       @default(AVAILABLE)
  receivedAt      DateTime             @default(now())

  originCollectionId           String?
  originCollectionMaterialId   String?
  originCollectionWasteEntryId String?
  createdByUserId              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cooperative                Cooperative                 @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  stockItem                  WasteStockItem              @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  destination                CollectionWasteDestination? @relation("WasteStockLotDestination")
  originCollection           Collection?                 @relation("WasteStockLotOriginCollection", fields: [originCollectionId], references: [id], onDelete: SetNull)
  originCollectionMaterial   CollectionMaterial?         @relation("WasteStockLotOriginCollectionMaterial", fields: [originCollectionMaterialId], references: [id], onDelete: SetNull)
  originCollectionWasteEntry CollectionWasteEntry?       @relation("WasteStockLotOriginCollectionWasteEntry", fields: [originCollectionWasteEntryId], references: [id], onDelete: SetNull)
  createdBy                  User?                       @relation("WasteStockLotCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([cooperativeId, code])
  @@unique([cooperativeId, lotCode])
  @@index([cooperativeId])
  @@index([stockItemId])
  @@index([unit])
  @@index([status])
  @@index([processingStage])
  @@index([receivedAt])
  @@index([originCollectionId])
  @@index([originCollectionMaterialId])
  @@index([originCollectionWasteEntryId])
  @@index([createdByUserId])
}

model Bin {
  id                 String    @id @default(cuid())
  cooperativeId      String
  vehicleId          String?
  binId              String
  binType            String?
  location           String?
  capacityKg         Float?
  notes              String?
  photoUrl           String?
  lastCollectionDate DateTime?
  status             BinStatus @default(ACTIVE)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([cooperativeId, binId])
  @@index([cooperativeId])
  @@index([vehicleId])
  @@index([status])
  @@index([binType])
}

model VehicleDocument {
  id             String    @id @default(cuid())
  cooperativeId  String
  vehicleId      String?
  documentType   String
  documentNumber String
  issueDate      DateTime?
  expiryDate     DateTime?
  fileUrl        String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([cooperativeId])
  @@index([vehicleId])
  @@index([documentType])
  @@index([expiryDate])
}

model MaintenanceLog {
  id                  String            @id @default(cuid())
  cooperativeId       String
  vehicleId           String
  maintenanceType     String
  maintenanceDate     DateTime
  location            String?
  cost                Float?
  performedBy         String?
  nextMaintenanceDate DateTime?
  notes               String?
  fileUrl             String?
  status              MaintenanceStatus @default(COMPLETED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([cooperativeId])
  @@index([vehicleId])
  @@index([status])
  @@index([maintenanceDate])
  @@index([nextMaintenanceDate])
}

enum UserRole {
  PF
  GENERATOR_SMALL
  GENERATOR_LARGE
  COOPERATIVE
  COLLECTOR
  DRIVER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum GeneratorType {
  SMALL
  LARGE
}

enum GeneratorAccessStatus {
  PENDING_ACTIVATION
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CollectorStatus {
  AVAILABLE
  ON_ROUTE
  INACTIVE
}

enum CollectorSex {
  FEMALE
  MALE
  INTERSEX
  NOT_INFORMED
}

enum CollectorGender {
  CIS_WOMAN
  CIS_MAN
  TRANS_WOMAN
  TRANS_MAN
  NON_BINARY
  OTHER
  NOT_INFORMED
}

enum ScheduleStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CollectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CollectionEntryStatus {
  PENDING_DESTINATION
  SENT_TO_TRIAGE
  ADDED_TO_STOCK
  PARTIALLY_DESTINED
  FULLY_DESTINED
  REJECTED
  DISCARDED
  DIRECTLY_DESTINED
  RESERVED
  CANCELLED
}

enum WasteDestinationType {
  STOCK
  TRIAGE
  REJECT
  DISPOSAL
  DIRECT_DESTINATION
  RESERVATION
}

enum WasteDestinationStatus {
  ACTIVE
  CANCELLED
}

enum DriverStatus {
  AVAILABLE
  ON_ROUTE
  INACTIVE
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum DriverReportType {
  DELAY
  MECHANICAL_ISSUE
  COLLECTION_NOT_COMPLETED
  GENERAL_NOTE
}

enum RouteStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FeedbackCategory {
  ATENDIMENTO
  PONTUALIDADE
  COLETA
  APLICATIVO
  COMUNICACAO
}

enum WasteStockStatus {
  ACTIVE
  INACTIVE
}

enum WasteLotStatus {
  AVAILABLE
  RESERVED
  SOLD
  DISCARDED
  CANCELLED
}

enum WasteProcessingStage {
  TRIADO
  TRITURADO
  PRENSADO
  ENFARDADO
  ARMAZENADO
  DESTINADO
}

enum WasteUnit {
  KG
  TON
  LITER
  UNIT
  CUBIC_METER
}

enum WasteClass {
  CLASS_I
  CLASS_II_A
  CLASS_II_B
  NOT_INFORMED
}

enum BinStatus {
  ACTIVE
  INACTIVE
  FULL
  MAINTENANCE
}

enum MaintenanceStatus {
  COMPLETED
  PENDING
  SCHEDULED
  OVERDUE
}
