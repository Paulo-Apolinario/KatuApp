NODE_ENV=production
APP_ENV=production
PORT=3333
DATABASE_URL="postgresql://USUARIO:SENHA@127.0.0.1:5432/BANCO?schema=public"
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE_COM_MAIS_DE_32_CARACTERES"
JWT_EXPIRES_IN=7d
CORS_ORIGIN="https://painel.katua.com.br,https://app.katua.com.br"
LOG_LEVEL=info

# Preencher somente no servidor. Nunca disponibilizar no frontend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_WEB_URL=https://app.katua.com.br
PANEL_WEB_URL=https://painel.katua.com.br

# SINIR: autenticação e leitura. Emissão permanece bloqueada no código.
# Preencher a credencial somente no .env privado da VPS, nunca no GitHub/frontend.
SINIR_ENABLED=false
SINIR_ENVIRONMENT=UNCONFIRMED
SINIR_BASE_URL=https://admin.sinir.gov.br/api
SINIR_INTEGRATION_TOKEN=
# Vínculo de UMA credencial à unidade local da central.
SINIR_LOCAL_UNIT_ID=
SINIR_UNIT_TAX_ID=
SINIR_OFFICIAL_UNIT_CODE=

# Chave privada AES-256 (32 bytes em base64) para SMTP por cooperativa.
# Gerar na VPS: openssl rand -base64 32. Preservar junto ao backup do banco.
SETTINGS_ENCRYPTION_KEY=

# Arquivos documentais privados; caminho absoluto opcional.
# DOCUMENT_STORAGE_DIR=/var/www/katua/app/server/storage/documents
