{
  "extends": "expo/tsconfig.base",

  "compilerOptions": {
    "target": "ES2020",

    "moduleResolution": "bundler",

    "strict": true,

    "baseUrl": ".",

    "paths": {
      "@/*": ["./*"]
    },

    "skipLibCheck": true
  },

  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}